# Optional. Copied into Settings → Sources on first start, then managed there.
LIDARR_URL=http://192.168.1.103:8686
LIDARR_API_KEY=
PORT=4000

# Where the server reads audio files from: none | local | sftp | ssh
#   ssh = run stat/tail over SSH (for NAS boxes whose SFTP is restricted, e.g. UGREEN UGOS)
MEDIA_SOURCE=none
# Lidarr path prefix = path as seen by Playarr (local fs or SFTP host)
PATH_MAP=/data/media/music=/data/media/music

# SSH connection (MEDIA_SOURCE=sftp or ssh). Auth: key file, else password, else ssh-agent
SSH_HOST=192.168.1.103
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=
SSH_PASSWORD=

# Requests: where new artists go in Lidarr, when Settings → Requests hasn't chosen (default: the root folder's own)
# LIDARR_ROOT_FOLDER=
# LIDARR_QUALITY_PROFILE_ID=
# LIDARR_METADATA_PROFILE_ID=
# MusicBrainz asks clients for a contact (URL or email)
# MUSICBRAINZ_CONTACT=self-hosted

# Audio analysis (on | off): DJ mix, even volume, mood mixes, radio and playlist covers. ffmpeg runs where the files are:
# on the SSH host for MEDIA_SOURCE=ssh, locally for MEDIA_SOURCE=local.
ANALYSIS=on
FFMPEG_PATH=ffmpeg
# Chromaprint's fpcalc, for identifying songs by their sound (optional)
FPCALC_PATH=fpcalc
# RCLONE_PATH=rclone   # for folder sources on SMB shares

# Deploying to the NAS (pnpm deploy:nas; see docker/compose.yaml). Uses the SSH settings above.
# Docker on the NAS needs sudo: NAS_SUDO_PASSWORD defaults to SSH_PASSWORD.
NAS_DIR=/volume1/docker/playarr
NAS_MUSIC_DIR=/volume2/data/media/music
NAS_SUDO_PASSWORD=
# Lidarr as seen from the NAS (defaults to LIDARR_URL)
NAS_LIDARR_URL=

# Folders that folder sources may use and Settings may browse (comma-separated absolute paths).
# Default: the whole disk when running natively; the Docker image uses /host.
FOLDER_ROOTS=

# Before the owner's account has a password, settings can only be changed from the home network, by IP or a local
# name (nas, *.local, *.lan); afterwards admins change them from anywhere. Other host names you open Playarr by
# on the home network (comma-separated), e.g. music.example.com. Requests through a reverse proxy always count as from outside.
LOCAL_HOSTNAMES=

# This server's address as people reach it, usually through a reverse proxy. Every client uses it: the iOS app
# remembers the server by it, the web pages send you there after signing in elsewhere (e.g. after claiming the
# server at http://192.168.1.103:4000/setup), and setup-code links point at it.
# PUBLIC_URL=https://tracklist.me
# Behind a reverse proxy: the proxy to believe about the visitor (X-Forwarded-For, -Proto, -Host), so sign-in
# limits count per visitor and cookies are marked Secure. Give the proxy's address as Playarr sees it, not a
# hop count: comma-separated addresses or CIDRs, loopback (a proxy on the same machine as a native install or a
# host-networked container), or true (any; only if nothing else can reach the port).
#   - proxy on the NAS itself, Playarr in Docker with the port mapping: the Docker network's gateway, from
#     docker network inspect playarr_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'   (e.g. 172.18.0.1)
#   - proxy on another machine: that machine's LAN address (e.g. 192.168.1.20)
#   - proxy in a container on Playarr's Docker network: that network's subnet (same command, .Subnet)
# Not sure? Start Playarr with LOG_REQUESTS=1 and read remoteAddress in the log of a request made through the proxy.
# TRUST_PROXY=172.18.0.1

# Artwork cache size in MB; the least recently used images are removed past it.
# ART_CACHE_MB=2048
# Rendered transitions (DJ mix) cache size in MB; the least recently played are removed past it.
# TRANSITIONS_CACHE_MB=1024

# What apps call this server (default: the machine's name).
# SERVER_NAME=Living room
# Advertise the server on the home network (Bonjour, _playarr._tcp) so the iOS app finds it: on | off.
# Works for native installs and Docker with host networking.
# BONJOUR=on
