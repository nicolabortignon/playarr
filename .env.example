# Optional. Copied into Settings → Sources on first start, then managed there.
LIDARR_URL=http://192.168.1.103:8686
LIDARR_API_KEY=
PORT=4000

# Where the server reads audio files from: none | local | sftp | ssh
#   ssh = run stat/tail over SSH (for NAS boxes whose SFTP is restricted, e.g. UGREEN UGOS)
MEDIA_SOURCE=none
# Lidarr path prefix = path as seen by Playarr (local fs or SFTP host)
PATH_MAP=/data/media/music=/data/media/music

# SSH connection (MEDIA_SOURCE=sftp or ssh). Auth: key file, else password, else ssh-agent
SSH_HOST=192.168.1.103
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=
SSH_PASSWORD=

# Audio analysis for generated playlist covers (on | off). ffmpeg runs where the files are:
# on the SSH host for MEDIA_SOURCE=ssh, locally for MEDIA_SOURCE=local.
ANALYSIS=on
FFMPEG_PATH=ffmpeg
# Chromaprint's fpcalc, for identifying songs by their sound (optional)
FPCALC_PATH=fpcalc

# Deploying to the NAS (pnpm deploy:nas; see docker/compose.yaml). Uses the SSH settings above.
# Docker on the NAS needs sudo: NAS_SUDO_PASSWORD defaults to SSH_PASSWORD.
NAS_DIR=/volume1/docker/playarr
NAS_MUSIC_DIR=/volume2/data/media/music
NAS_SUDO_PASSWORD=
# Lidarr as seen from the NAS (defaults to LIDARR_URL)
NAS_LIDARR_URL=

# Folders that folder sources may use and Settings may browse (comma-separated absolute paths).
# Default: the whole disk when running natively; the Docker image uses /host.
FOLDER_ROOTS=
