{
  "name": "playarr",
  "private": true,
  "version": "0.6.482",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "pnpm --parallel --filter @playarr/server --filter @playarr/web dev",
    "dev:server": "pnpm --filter @playarr/server dev",
    "dev:web": "pnpm --filter @playarr/web dev",
    "build": "pnpm --filter @playarr/web build && pnpm --filter @playarr/server build",
    "start": "pnpm --filter @playarr/server start",
    "typecheck": "pnpm -r typecheck",
    "deploy:nas": "node --env-file=.env --disable-warning=ExperimentalWarning docker/deploy.mjs",
    "sim": "node scripts/ios-sim/sim.mjs",
    "ios:bootstrap": "make -C apps/ios bootstrap",
    "ios:build": "make -C apps/ios build",
    "ios:test": "make -C apps/ios test",
    "ios:models": "make -C apps/ios models",
    "ios:setup": "make -C apps/ios setup",
    "ios:crashes": "make -C apps/ios crashes",
    "ios:screens": "make -C apps/ios screens",
    "ios:beta": "make -C apps/ios beta",
    "ios:device": "make -C apps/ios device",
    "ios:screenshots": "make -C apps/ios screenshots",
    "ios:release": "make -C apps/ios release"
  },
  "devDependencies": {
    "bplist-creator": "^0.3.0",
    "bplist-parser": "^0.5.0",
    "ts-json-schema-generator": "2.9.0"
  }
}
