# dependencies & build output
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo

# runtime caches (artwork, requests) and user data (favorites database)
.cache/
apps/server/data/

# secrets: Lidarr API key, NAS password
.env
.env.*
!.env.example

# local tooling
.claude/
.DS_Store
*.log

# iOS app: the generated Xcode project, the downloaded XcodeGen, build output
apps/ios/.tools/
apps/ios/Playarr.xcodeproj/
apps/ios/build/
apps/ios/Packages/*/.build/
apps/ios/Packages/*/.swiftpm/
*.xcarchive
.DerivedData/
xcuserdata/

# App Store Connect API keys: never commit one, even copied into the repo by hand
*.p8

# The latest screenshots of each device's main views (pnpm ios:screens)
/screenshots/
